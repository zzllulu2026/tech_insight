{
  "outputDir": "out",
  "maxItemsPerSource": 25,
  "sources": [
    {
      "id": "hn",
      "name": "Hacker News",
      "type": "hn",
      "lang": "en",
      "group": "community",
      "url": "https://hn.algolia.com/api/v1/search?tags=front_page&hitsPerPage=25"
    },
    {
      "id": "github",
      "name": "GitHub Trending",
      "type": "github",
      "lang": "en",
      "group": "community",
      "url": "https://api.github.com/search/repositories?q=created:%3E{YESTERDAY}&sort=stars&order=desc&per_page=20"
    },
    {
      "id": "hf-papers",
      "name": "Hugging Face Daily Papers",
      "type": "json",
      "lang": "en",
      "group": "paper",
      "url": "https://huggingface.co/api/daily_papers",
      "path": "$[*].paper",
      "map": {
        "id": "id",
        "title": "title",
        "summary": "summary",
        "url": "https://huggingface.co/papers/{id}",
        "published": "publishedAt",
        "scoreField": "paper.upvotes"
      }
    },
    {
      "id": "arxiv-ai",
